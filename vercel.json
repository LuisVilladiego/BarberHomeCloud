{
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/landing.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/favicon.png" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/registro", "destination": "/login.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    {
      "source": "/:slug((?!api/)(?!.*\\.).*)",
      "destination": "/booking.html"
    }
  ],
  "crons": [
    {
      "path": "/api/trial/remind",
      "schedule": "0 14 * * *"
    }
  ]
}
