# Variables para las funciones serverless de Vercel (Project Settings → Environment Variables).
# Ninguna de estas llega al navegador: se usan solo en api/.

# Supabase → Project Settings → API
SUPABASE_URL=https://tyxcqogdrwlzglgntluc.supabase.co
# service_role key: salta RLS. Nunca la pongas en js/ ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Wompi → Dashboard de comercios → Desarrolladores / Secretos para integración técnica
# Usa las llaves pub_test_/test_ mientras pruebas y pub_prod_/prod_ en producción.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# El secreto de eventos es distinto de la llave privada.
WOMPI_EVENTS_SECRET=

# Opcional: fuerza la URL de redirección tras pagar. Si falta, se deduce del request.
PUBLIC_BASE_URL=https://barber-home-cloud.vercel.app

# Panel super-admin SaaS: correos separados por coma con acceso a /admin
PLATFORM_ADMIN_EMAILS=adminbarbercloud@gmail.com

# Correo OTP (Google Apps Script) — solo servidor, no expongas en js/
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbySOcHmfyYq7Z30E9tiMgKs76FkdBkBxKKNc6S-oaur7QJ8HWCq3sfN_MJFw-mXQ8h7/exec
APPS_SCRIPT_SECRET=barberhome-otp-2026
# Opcional: firma de tokens OTP (si falta, usa APPS_SCRIPT_SECRET)
OTP_SECRET=barberhome-otp-2026

# WhatsApp (Twilio) — consulta de reservas con verificación por teléfono
# Console: https://console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remitente WhatsApp en E.164 (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=
# Alias opcional de TWILIO_WHATSAPP_FROM
TWILIO_FROM_NUMBER=
# Plantilla WhatsApp (ContentSid HX...). En sandbox puede omitirse (usa la del trial).
# Producción: crea plantilla whatsapp/authentication en Twilio → Content Template Builder.
TWILIO_WHATSAPP_CONTENT_SID=
# auth = solo {{1}} con el código OTP. Omitir si usas la plantilla del sandbox.
TWILIO_WHATSAPP_CONTENT_MODE=
# Plantilla utility para confirmaciones/recordatorios ({{1}} = cuerpo completo).
# En sandbox se usa la plantilla de prueba con fecha + detalle si se omite.
TWILIO_WHATSAPP_UTILITY_CONTENT_SID=
